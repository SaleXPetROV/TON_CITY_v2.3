# /etc/gram-backup.env  (chmod 600, owner root) — settings of the hourly backup
PROJECT_DIR=/opt/gram-city
# host = python on this machine talks to MongoDB directly; docker = the project runs with docker compose
BACKUP_MODE=docker
LOCAL_DIR=/var/backups/gram
# rclone remote configured with `rclone config` (S3, Backblaze B2 or Yandex Object Storage) + bucket
RCLONE_REMOTE=b2:gram-city-backups
KEEP_HOURLY=48
KEEP_DAILY=30
DAILY_HOUR=03
# same MONGO_URL / DB_NAME as the server
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=ton_city
# 32 bytes base64:  cd backend && python -m scripts.backup_encrypted --new-key
# Keep a second copy of this key OFF the server (password manager): without it the backups can't be read.
BACKUP_KEY=
# failure alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
